# Copy to .env and fill in. Do NOT commit .env — the iCal URL is a secret.

# Google Calendar > Settings > (your calendar) > "Secret address in iCal format"
ICAL_URL=https://calendar.google.com/calendar/ical/reception%40cathedralschool.ca/public/basic.ics

# IANA timezone for the school. Drives both the clock and which day is "today".
TZ=America/Vancouver

# Seconds between calendar fetches. 120 = the board picks up a calendar change
# within about two minutes. Keep this between 60 and 480.
REFRESH_SECONDS=120

# Optional: override the values in config/theme.json without editing the file.
# SCHOOL_NAME=Riverbend Public School
# SCHOOL_TAGLINE=Today at a glance

PORT=8080
